@model IEnumerable<GymManager.Models.Member>

@{
    ViewData["Title"] = "Members";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="gym-badge gym-badge-primary">
                <i class="bi bi-people-fill"></i> Directory
            </span>
            <span class="gym-badge gym-badge-info">
                @Model.Count() Registered Members
            </span>
        </div>
        <h1>Gym Members</h1>
        <p>Manage all registered athletes and gym members in your facility.</p>
    </div>

    <div>
        <a asp-action="Create" class="btn-gym-primary">
            <i class="bi bi-person-plus-fill"></i> Add New Member
        </a>
    </div>
</div>

<!-- Table Card -->
<div class="gym-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="gym-table">
                <thead>
                    <tr>
                        <th class="ps-4">Member Name</th>
                        <th>Phone Number</th>
                        <th>Registration Date</th>
                        <th>Notes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var initial = string.IsNullOrEmpty(item.FullName) ? "M" : item.FullName.Substring(0, 1).ToUpper();
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center"
                                         style="width: 38px; height: 38px; font-size: 0.95rem;">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.FullName</div>
                                        <small class="text-muted">ID: #@item.Id.ToString("D4")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary fw-semibold">
                                    <i class="bi bi-telephone me-1 text-muted"></i>@item.Phone
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary">
                                    <i class="bi bi-calendar-check me-1 text-muted"></i>@item.RegistrationDate.ToString("dd MMM yyyy", englishCulture)
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <span class="text-truncate d-inline-block text-muted" style="max-width: 220px;" title="@item.Notes">
                                        @item.Notes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">No notes</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action-icon" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-icon" title="Edit Member">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-icon delete" title="Delete Member">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="gym-card-body text-center py-5">
            <div class="text-muted fs-1 mb-3"><i class="bi bi-people"></i></div>
            <h5 class="fw-bold text-dark">No members found</h5>
            <p class="text-muted mb-4">Start registering your gym members to track their memberships and attendance.</p>
            <a asp-action="Create" class="btn-gym-primary">
                <i class="bi bi-person-plus-fill"></i> Add First Member
            </a>
        </div>
    }
</div>
