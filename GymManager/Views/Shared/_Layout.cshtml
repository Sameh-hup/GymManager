<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />

    <title>@ViewData["Title"] - GymManager</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymManager.styles.css" asp-append-version="true" />
</head>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<body class="gym-body">
    <!-- Header & Navigation -->
    <header class="gym-header sticky-top">
        <nav class="navbar navbar-expand-lg gym-navbar">
            <div class="container-fluid px-3 px-lg-4">

                <!-- Brand Logo -->
                <a class="navbar-brand gym-brand d-flex align-items-center gap-2"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <span class="gym-brand-icon">
                        <i class="bi bi-activity"></i>
                    </span>
                    <span class="gym-brand-text">Gym<span class="text-primary">Manager</span></span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler gym-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Nav Items -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gym-nav-list">

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "Members" ? "active" : "")"
                               asp-controller="Members"
                               asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i> Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "MembershipPlans" ? "active" : "")"
                               asp-controller="MembershipPlans"
                               asp-action="Index">
                                <i class="bi bi-card-checklist me-1"></i> Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "Memberships" ? "active" : "")"
                               asp-controller="Memberships"
                               asp-action="Index">
                                <i class="bi bi-person-badge-fill me-1"></i> Memberships
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "Payments" ? "active" : "")"
                               asp-controller="Payments"
                               asp-action="Index">
                                <i class="bi bi-credit-card-fill me-1"></i> Payments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "Attendance" ? "active" : "")"
                               asp-controller="Attendance"
                               asp-action="Index">
                                <i class="bi bi-qr-code-scan me-1"></i> Attendance
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gym-nav-link @(currentController == "DayPasse" ? "active" : "")"
                               asp-controller="DayPasse"
                               asp-action="Index">
                                <i class="bi bi-ticket-perforated-fill me-1"></i> Day Passes
                            </a>
                        </li>

                    </ul>

                    <!-- Status Pill -->
                    <div class="d-none d-lg-flex align-items-center">
                        <div class="gym-status-badge">
                            <span class="gym-status-pulse"></span>
                            <span>System Active</span>
                        </div>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="container-fluid px-3 px-lg-4 py-4 gym-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="gym-footer mt-auto py-3">
        <div class="container-fluid px-3 px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-muted small">
                &copy; @DateTime.Now.Year <strong class="text-dark">GymManager</strong> &mdash; All rights reserved.
            </span>
            <span class="text-muted small">
                Minimalist SaaS Edition
            </span>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>