@model GymManager.Models.MembershipPlan

@{
    ViewData["Title"] = "Delete Plan";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Plans
        </a>
        <h1 class="text-danger">Delete Membership Plan</h1>
        <p>Confirm deletion of this subscription plan.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        <div class="gym-card border-danger-subtle">
            <div class="gym-card-header bg-danger-subtle">
                <h5 class="gym-card-title text-danger d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion
                </h5>
            </div>
            <div class="gym-card-body">
                <p class="text-secondary mb-4">
                    Are you sure you want to delete the plan <strong>@Model.Name</strong>?
                    Note that active member subscriptions assigned to this plan might prevent deletion or be affected.
                </p>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Plan Name:</span>
                        <strong class="text-dark">@Model.Name</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Price:</span>
                        <strong class="text-success">$@Model.Price.ToString("N2", englishCulture)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Duration:</span>
                        <span class="text-dark">@Model.DurationInDays Days</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Status:</span>
                        <span class="text-dark">@(Model.IsActive ? "Active" : "Inactive")</span>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-trash3-fill me-1"></i> Yes, Delete Plan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
