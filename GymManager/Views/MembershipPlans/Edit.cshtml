@model GymManager.Models.MembershipPlan

@{
    ViewData["Title"] = "Edit Plan";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Plans
        </a>
        <h1>Edit Membership Plan</h1>
        <p>Modify duration, pricing, or status for this plan.</p>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i> Edit Plan: @Model.Name
                </h5>
            </div>
            <div class="gym-card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Plan Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-card-heading text-muted"></i></span>
                            <input asp-for="Name" class="form-control border-start-0" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="DurationInDays" class="form-label">Duration (in Days) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-clock-history text-muted"></i></span>
                                <input asp-for="DurationInDays" type="number" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="DurationInDays" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Price" class="form-label">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar text-muted"></i></span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Plan Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch p-0 d-flex align-items-center gap-3">
                        <input asp-for="IsActive" class="form-check-input ms-0" type="checkbox" role="switch" id="isActiveSwitch" style="width: 2.5em; height: 1.25em;">
                        <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">
                            Make this plan active and available for subscription
                        </label>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn-gym-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
