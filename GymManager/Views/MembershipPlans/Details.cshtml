@model GymManager.Models.MembershipPlan

@{
    ViewData["Title"] = "Plan Details";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Plans
        </a>
        <h1>Plan Details</h1>
        <p>Overview of the configuration and pricing for this membership tier.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-gym-primary">
            <i class="bi bi-pencil-square"></i> Edit Plan
        </a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn-gym-outline text-danger">
            <i class="bi bi-trash3"></i> Delete
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-award-fill text-primary"></i> @Model.Name
                </h5>
                @if (Model.IsActive)
                {
                    <span class="gym-badge gym-badge-success">
                        <span class="gym-status-pulse"></span> Active
                    </span>
                }
                else
                {
                    <span class="gym-badge gym-badge-danger">Inactive</span>
                }
            </div>
            <div class="gym-card-body">
                <div class="row g-4">
                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Plan Name</label>
                        <div class="fw-bold fs-5 text-dark">@Model.Name</div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Subscription Price</label>
                        <div class="fw-bold fs-4 text-success">$@Model.Price.ToString("N2", englishCulture)</div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Validity Period</label>
                        <div class="fw-bold fs-6 text-dark">
                            <i class="bi bi-calendar-range text-primary me-1"></i> @Model.DurationInDays Days
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Plan Status</label>
                        <div>
                            @if (Model.IsActive)
                            {
                                <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Active for new signups</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i> Suspended</span>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small text-uppercase">Plan Description & Benefits</label>
                        <div class="p-3 bg-light rounded-3 border text-secondary">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No detailed description has been added for this plan.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
