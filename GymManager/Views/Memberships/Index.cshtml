@model IEnumerable<GymManager.Models.Membership>

@{
    ViewData["Title"] = "Memberships";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    var totalMemberships = Model.Count();
    var activeCount = Model.Count(m => m.EndDate >= DateTime.Today);
    var expiringCount = Model.Count(m => m.EndDate >= DateTime.Today && m.EndDate <= DateTime.Today.AddDays(7));
    var expiredCount = Model.Count(m => m.EndDate < DateTime.Today);
    var totalDebt = Model.Sum(m => Math.Max(0, m.PriceAtPurchase - (m.Payments != null ? m.Payments.Sum(p => p.Amount) : 0)));
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="gym-badge gym-badge-primary">
                <i class="bi bi-person-badge-fill"></i> Subscriptions Management
            </span>
            <span class="gym-badge gym-badge-success">
                @activeCount Active Members
            </span>
            @if (totalDebt > 0)
            {
                <span class="gym-badge gym-badge-warning">
                    Outstanding Due: $@totalDebt.ToString("N2", englishCulture)
                </span>
            }
        </div>
        <h1>Member Subscriptions</h1>
        <p>Filter subscriptions by active status, payment completion, or review expiration dates.</p>
    </div>

    <div>
        <a asp-action="Create" class="btn-gym-primary">
            <i class="bi bi-plus-lg"></i> New Subscription
        </a>
    </div>
</div>

<!-- Filter Tabs & Search Bar -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <!-- Filter Tabs -->
    <div class="btn-group bg-white p-1 rounded-3 border shadow-sm" role="group" id="membershipFilterGroup">
        <button type="button" class="btn btn-sm btn-light fw-bold active text-primary" data-filter="all">
            All (@totalMemberships)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="active">
            <span class="gym-status-pulse d-inline-block me-1" style="width:6px;height:6px;"></span> Active Only (@activeCount)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="expiring">
            <i class="bi bi-clock text-warning me-1"></i> Expiring Soon (@expiringCount)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="expired">
            <i class="bi bi-x-circle text-danger me-1"></i> Expired (@expiredCount)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="unpaid">
            <i class="bi bi-exclamation-circle text-danger me-1"></i> Unpaid / Due
        </button>
    </div>

    <!-- Quick Search -->
    <div class="input-group" style="max-width: 280px;">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" id="memberSearchInput" class="form-control border-start-0 bg-white" placeholder="Search member or phone..." />
    </div>
</div>

<!-- Table Card -->
<div class="gym-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="gym-table" id="membershipsTable">
                <thead>
                    <tr>
                        <th class="ps-4">Member</th>
                        <th>Plan</th>
                        <th>Period</th>
                        <th>Plan Price</th>
                        <th>Payment Status</th>
                        <th>Validity</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isExpired = item.EndDate < DateTime.Today;
                        var isExpiringSoon = !isExpired && item.EndDate <= DateTime.Today.AddDays(7);
                        var initial = string.IsNullOrEmpty(item.Member?.FullName) ? "M" : item.Member.FullName.Substring(0, 1).ToUpper();

                        var totalPaid = item.Payments != null ? item.Payments.Sum(p => p.Amount) : 0m;
                        var remainingDue = Math.Max(0, item.PriceAtPurchase - totalPaid);
                        var isFullyPaid = totalPaid >= item.PriceAtPurchase;
                        var isPartial = !isFullyPaid && totalPaid > 0;
                        var isUnpaid = totalPaid == 0;

                        var rowFilterCategory = isExpired ? "expired" : (isExpiringSoon ? "expiring active" : "active");
                        if (!isFullyPaid) { rowFilterCategory += " unpaid"; }

                        <tr class="membership-row" 
                            data-status="@rowFilterCategory" 
                            data-name="@(item.Member?.FullName?.ToLower() ?? "")"
                            data-phone="@(item.Member?.Phone ?? "")">
                            
                            <!-- Member Info -->
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center"
                                         style="width: 38px; height: 38px; font-size: 0.95rem;">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(item.Member?.FullName ?? "Unknown Member")</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(item.Member?.Phone ?? "-")</small>
                                    </div>
                                </div>
                            </td>

                            <!-- Plan -->
                            <td>
                                <span class="gym-badge gym-badge-primary">
                                    <i class="bi bi-award me-1"></i>@(item.MembershipPlan?.Name ?? "Custom Plan")
                                </span>
                            </td>

                            <!-- Period -->
                            <td>
                                <div>
                                    <span class="text-dark fw-semibold small">
                                        @item.StartDate.ToString("dd MMM yyyy", englishCulture)
                                    </span>
                                    <span class="text-muted small mx-1">&rarr;</span>
                                    <span class="small @(isExpired ? "text-danger fw-bold" : (isExpiringSoon ? "text-warning fw-bold" : "text-dark fw-semibold"))">
                                        @item.EndDate.ToString("dd MMM yyyy", englishCulture)
                                    </span>
                                </div>
                            </td>

                            <!-- Price -->
                            <td>
                                <span class="fw-bold text-dark">
                                    $@item.PriceAtPurchase.ToString("N2", englishCulture)
                                </span>
                            </td>

                            <!-- Payment Status -->
                            <td>
                                @if (isFullyPaid)
                                {
                                    <span class="gym-badge gym-badge-success" title="Fully Paid">
                                        <i class="bi bi-check-circle-fill"></i> Paid ($@totalPaid.ToString("N2", englishCulture))
                                    </span>
                                }
                                else if (isPartial)
                                {
                                    <span class="gym-badge gym-badge-warning" title="Partial Payment">
                                        <i class="bi bi-pie-chart-fill"></i> Paid $@totalPaid.ToString("N0") <small class="text-danger fw-bold">(Due: $@remainingDue.ToString("N0"))</small>
                                    </span>
                                }
                                else
                                {
                                    <span class="gym-badge gym-badge-danger" title="Unpaid">
                                        <i class="bi bi-exclamation-octagon-fill"></i> Unpaid ($@remainingDue.ToString("N2", englishCulture))
                                    </span>
                                }
                            </td>

                            <!-- Validity Status -->
                            <td>
                                @if (isExpired)
                                {
                                    <span class="gym-badge gym-badge-danger">
                                        Expired
                                    </span>
                                }
                                else if (isExpiringSoon)
                                {
                                    <span class="gym-badge gym-badge-warning">
                                        <i class="bi bi-clock"></i> Expiring Soon
                                    </span>
                                }
                                else
                                {
                                    <span class="gym-badge gym-badge-success">
                                        <span class="gym-status-pulse"></span> Active
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    @if (!isFullyPaid)
                                    {
                                        <a asp-controller="Payments" asp-action="Create" class="btn btn-sm btn-outline-success py-1 px-2 me-1" 
                                           style="font-size: 0.775rem;" title="Collect Remaining Payment">
                                            <i class="bi bi-cash"></i> Pay
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action-icon" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-icon" title="Edit Subscription">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-icon delete" title="Delete Subscription">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="gym-card-body text-center py-5">
            <div class="text-muted fs-1 mb-3"><i class="bi bi-person-badge"></i></div>
            <h5 class="fw-bold text-dark">No memberships found</h5>
            <p class="text-muted mb-4">Assign membership plans to your registered gym members to start tracking subscriptions.</p>
            <a asp-action="Create" class="btn-gym-primary">
                <i class="bi bi-plus-lg"></i> Create First Membership
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('#membershipFilterGroup button');
            const searchInput = document.getElementById('memberSearchInput');
            const rows = document.querySelectorAll('.membership-row');

            let currentFilter = 'all';
            let currentSearch = '';

            function applyFilters() {
                rows.forEach(row => {
                    const rowStatus = row.getAttribute('data-status') || '';
                    const rowName = row.getAttribute('data-name') || '';
                    const rowPhone = row.getAttribute('data-phone') || '';

                    const matchesFilter = (currentFilter === 'all') || rowStatus.includes(currentFilter);
                    const matchesSearch = !currentSearch || rowName.includes(currentSearch) || rowPhone.includes(currentSearch);

                    if (matchesFilter && matchesSearch) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'text-primary');
                        b.classList.add('text-secondary');
                    });
                    this.classList.add('active', 'text-primary');
                    this.classList.remove('text-secondary');

                    currentFilter = this.getAttribute('data-filter');
                    applyFilters();
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = this.value.trim().toLowerCase();
                    applyFilters();
                });
            }
        });
    </script>
}