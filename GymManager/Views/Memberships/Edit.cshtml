@model GymManager.Models.Membership

@{
    ViewData["Title"] = "Edit Membership";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Memberships
        </a>
        <h1>Edit Membership</h1>
        <p>Adjust start date or details for this active membership.</p>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i> Membership #@Model.Id
                </h5>
            </div>
            <div class="gym-card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase">Member</label>
                        <div class="p-2 bg-light rounded-3 border fw-bold text-dark">
                            <i class="bi bi-person-fill text-primary me-2"></i>@(Model.Member?.FullName ?? "Unknown Member")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase">Membership Plan</label>
                        <div class="p-2 bg-light rounded-3 border fw-bold text-dark">
                            <i class="bi bi-award-fill text-primary me-2"></i>@(Model.MembershipPlan?.Name ?? "Custom Plan")
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event text-muted"></i></span>
                            <input asp-for="StartDate" type="date" class="form-control border-start-0" />
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <label class="form-label text-muted small text-uppercase">End Date</label>
                            <div class="p-2 bg-light rounded-3 border fw-semibold text-dark">
                                <i class="bi bi-calendar-check text-muted me-1"></i>@Model.EndDate.ToString("dd MMM yyyy", englishCulture)
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label text-muted small text-uppercase">Price at Purchase</label>
                            <div class="p-2 bg-light rounded-3 border fw-bold text-success">
                                $@Model.PriceAtPurchase.ToString("N2", englishCulture)
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn-gym-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}