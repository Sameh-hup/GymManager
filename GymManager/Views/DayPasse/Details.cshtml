@model GymManager.Models.DayPass

@{
    ViewData["Title"] = "Day Pass Details";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var visitor = string.IsNullOrWhiteSpace(Model.VisitorName) ? "Guest Visitor" : Model.VisitorName;
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Day Passes
        </a>
        <h1>Day Pass Receipt</h1>
        <p>Complete information on single-day guest access.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-gym-primary">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn-gym-outline text-danger">
            <i class="bi bi-trash3"></i> Delete
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-ticket-perforated-fill text-primary"></i> Pass #@Model.Id
                </h5>
                <span class="gym-badge gym-badge-info">@Model.PaymentMethod</span>
            </div>
            <div class="gym-card-body">
                <div class="row g-4">
                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Visitor Name</label>
                        <div class="fw-bold fs-5 text-dark">@visitor</div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Visitor Phone</label>
                        <div class="fw-semibold fs-6 text-dark">
                            <i class="bi bi-telephone text-primary me-1"></i>@(Model.VisitorPhone ?? "-")
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Visit Date & Time</label>
                        <div class="fw-bold fs-6 text-dark">
                            <i class="bi bi-clock-history text-muted me-1"></i>@Model.VisitDateTime.ToString("dd MMM yyyy · hh:mm tt", englishCulture)
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Payment Method</label>
                        <div>
                            <span class="gym-badge gym-badge-primary">@Model.PaymentMethod</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small text-uppercase">Entry Fee Paid</label>
                        <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                            <span class="text-secondary fw-semibold">Single Entry Fee</span>
                            <span class="fw-bold fs-4 text-success">$@Model.Fee.ToString("N2", englishCulture)</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small text-uppercase">Notes</label>
                        <div class="p-3 bg-light rounded-3 border text-secondary">
                            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded for this day pass." : Model.Notes)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>