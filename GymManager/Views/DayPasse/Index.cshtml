@model IEnumerable<GymManager.Models.DayPass>

@{
    ViewData["Title"] = "Day Passes";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    var todayPasses = Model.Where(d => d.VisitDateTime.Date == DateTime.Today).ToList();
    var yesterdayPasses = Model.Where(d => d.VisitDateTime.Date == DateTime.Today.AddDays(-1)).ToList();
    var todayRevenue = todayPasses.Sum(d => d.Fee);
    var totalRevenue = Model.Sum(d => d.Fee);
    var totalPasses = Model.Count();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="gym-badge gym-badge-primary">
                <i class="bi bi-ticket-perforated-fill"></i> Single-Day Access
            </span>
            <span class="gym-badge gym-badge-success">
                <span class="gym-status-pulse"></span> Today: $@todayRevenue.ToString("N2", englishCulture) (@todayPasses.Count Visitors)
            </span>
        </div>
        <h1>Day Passes & Walk-ins</h1>
        <p>Daily shift overview for guest visitors, one-time tickets, and walk-in revenues.</p>
    </div>

    <div>
        <a asp-action="Create" class="btn-gym-primary">
            <i class="bi bi-person-plus-fill"></i> Issue New Day Pass
        </a>
    </div>
</div>

<!-- Daily Shift KPIs -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-rose">
                <i class="bi bi-ticket-detailed-fill"></i>
            </div>
            <div>
                <div class="stat-label">Today's Visitors</div>
                <div class="stat-value text-dark">@todayPasses.Count Passes</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-emerald">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div>
                <div class="stat-label">Today's Revenue</div>
                <div class="stat-value text-success">$@todayRevenue.ToString("N2", englishCulture)</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-sky">
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>
            <div>
                <div class="stat-label">Total Day Passes Sold</div>
                <div class="stat-value text-primary">@totalPasses ($@totalRevenue.ToString("N0", englishCulture))</div>
            </div>
        </div>
    </div>
</div>

<!-- Date Filter Tabs & Search -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <!-- Day Filter Tabs -->
    <div class="btn-group bg-white p-1 rounded-3 border shadow-sm" role="group" id="dayPassFilterGroup">
        <button type="button" class="btn btn-sm btn-light fw-bold active text-primary" data-filter="today">
            <span class="gym-status-pulse d-inline-block me-1" style="width:6px;height:6px;"></span> Today (@todayPasses.Count)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="yesterday">
            Yesterday (@yesterdayPasses.Count)
        </button>
        <button type="button" class="btn btn-sm btn-light fw-semibold text-secondary" data-filter="all">
            All Visitors (@totalPasses)
        </button>
    </div>

    <!-- Date Picker & Live Search -->
    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-md-end" style="max-width: 480px;">
        <input type="date" id="dayPassDatePicker" class="form-control form-control-sm bg-white" style="max-width: 160px;" title="Pick specific date" />
        
        <div class="input-group input-group-sm flex-grow-1">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="dayPassSearchInput" class="form-control border-start-0 bg-white" placeholder="Search visitor or phone..." />
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="gym-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="gym-table" id="dayPassesTable">
                <thead>
                    <tr>
                        <th class="ps-4">Visitor</th>
                        <th>Phone</th>
                        <th>Visit Date & Time</th>
                        <th>Entry Fee</th>
                        <th>Payment Method</th>
                        <th>Notes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isToday = item.VisitDateTime.Date == DateTime.Today;
                        var isYesterday = item.VisitDateTime.Date == DateTime.Today.AddDays(-1);
                        var name = string.IsNullOrWhiteSpace(item.VisitorName) ? "Guest Visitor" : item.VisitorName;

                        var dayCategory = isToday ? "today" : (isYesterday ? "yesterday" : "older");
                        var isoDate = item.VisitDateTime.ToString("yyyy-MM-dd");

                        <tr class="daypass-row"
                            data-day="@dayCategory"
                            data-isodate="@isoDate"
                            data-name="@name.ToLower()"
                            data-phone="@(item.VisitorPhone ?? "")">

                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-info-subtle text-info fw-bold d-flex align-items-center justify-content-center"
                                         style="width: 36px; height: 36px; font-size: 0.9rem;">
                                        <i class="bi bi-ticket-detailed"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@name</div>
                                        <small class="text-muted">Pass ID: #@item.Id</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="text-secondary small">
                                    <i class="bi bi-telephone me-1 text-muted"></i>@(item.VisitorPhone ?? "-")
                                </span>
                            </td>

                            <td>
                                <div>
                                    <span class="fw-semibold text-dark">
                                        @item.VisitDateTime.ToString("dd MMM yyyy", englishCulture)
                                    </span>
                                    <small class="text-muted ms-1">@item.VisitDateTime.ToString("hh:mm tt", englishCulture)</small>
                                    @if (isToday)
                                    {
                                        <span class="gym-badge gym-badge-success py-0 px-2 ms-1" style="font-size: 0.7rem;">Today</span>
                                    }
                                </div>
                            </td>

                            <td>
                                <span class="fw-bold text-success fs-6">
                                    $@item.Fee.ToString("N2", englishCulture)
                                </span>
                            </td>

                            <td>
                                <span class="gym-badge gym-badge-info">
                                    @item.PaymentMethod
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 180px;" title="@item.Notes">
                                        @item.Notes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">-</span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action-icon" title="View Pass">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-icon" title="Edit Pass">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-icon delete" title="Delete Pass">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="gym-card-body text-center py-5">
            <div class="text-muted fs-1 mb-3"><i class="bi bi-ticket-perforated"></i></div>
            <h5 class="fw-bold text-dark">No day passes recorded</h5>
            <p class="text-muted mb-4">Register walk-in visitors and issue one-day entry tickets.</p>
            <a asp-action="Create" class="btn-gym-primary">
                <i class="bi bi-person-plus-fill"></i> Issue First Day Pass
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('#dayPassFilterGroup button');
            const searchInput = document.getElementById('dayPassSearchInput');
            const datePicker = document.getElementById('dayPassDatePicker');
            const rows = document.querySelectorAll('.daypass-row');

            let currentFilter = 'today'; // Default focused on TODAY!
            let currentSearch = '';
            let specificDate = '';

            function applyFilters() {
                rows.forEach(row => {
                    const rowDay = row.getAttribute('data-day') || '';
                    const rowIsoDate = row.getAttribute('data-isodate') || '';
                    const rowName = row.getAttribute('data-name') || '';
                    const rowPhone = row.getAttribute('data-phone') || '';

                    let matchesFilter = true;

                    if (specificDate) {
                        matchesFilter = (rowIsoDate === specificDate);
                    } else if (currentFilter === 'today') {
                        matchesFilter = (rowDay === 'today');
                    } else if (currentFilter === 'yesterday') {
                        matchesFilter = (rowDay === 'yesterday');
                    } else if (currentFilter === 'all') {
                        matchesFilter = true;
                    }

                    const matchesSearch = !currentSearch || rowName.includes(currentSearch) || rowPhone.includes(currentSearch);

                    if (matchesFilter && matchesSearch) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            // Default initial filter (Today)
            applyFilters();

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'text-primary');
                        b.classList.add('text-secondary');
                    });
                    this.classList.add('active', 'text-primary');
                    this.classList.remove('text-secondary');

                    currentFilter = this.getAttribute('data-filter');
                    specificDate = '';
                    if (datePicker) datePicker.value = '';
                    applyFilters();
                });
            });

            if (datePicker) {
                datePicker.addEventListener('change', function() {
                    specificDate = this.value;
                    if (specificDate) {
                        filterButtons.forEach(b => {
                            b.classList.remove('active', 'text-primary');
                            b.classList.add('text-secondary');
                        });
                    }
                    applyFilters();
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    currentSearch = this.value.trim().toLowerCase();
                    applyFilters();
                });
            }
        });
    </script>
}