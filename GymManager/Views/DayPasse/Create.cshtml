@model GymManager.Models.DayPass

@{
    ViewData["Title"] = "New Day Pass";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Day Passes
        </a>
        <h1>Register Day Pass</h1>
        <p>Issue a single-day visitor ticket and collect the entry fee.</p>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-ticket-detailed-fill text-primary"></i> Guest Visitor Details
                </h5>
            </div>
            <div class="gym-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="VisitorName" class="form-label">Visitor Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="VisitorName" class="form-control border-start-0" placeholder="Guest Name (Optional)" />
                        </div>
                        <span asp-validation-for="VisitorName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VisitorPhone" class="form-label">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                            <input asp-for="VisitorPhone" class="form-control border-start-0" placeholder="Contact number" />
                        </div>
                        <span asp-validation-for="VisitorPhone" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="VisitDateTime" class="form-label">Visit Date & Time <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-clock text-muted"></i></span>
                                <input asp-for="VisitDateTime" type="datetime-local" class="form-control border-start-0" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                            <span asp-validation-for="VisitDateTime" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Fee" class="form-label">Entry Fee ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar text-muted"></i></span>
                                <input asp-for="Fee" type="number" step="0.01" min="0" class="form-control border-start-0" placeholder="15.00" />
                            </div>
                            <span asp-validation-for="Fee" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Bank Transfer">Bank Transfer / Online</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Locker number, guest of member, event..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn-gym-primary">
                            <i class="bi bi-check-lg"></i> Issue Pass
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}