@model GymManager.Models.Attendance

@{
    ViewData["Title"] = "Record Attendance";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Attendance
        </a>
        <h1>Record Member Check-in</h1>
        <p>Log a member's visit to the gym floor with an optional note.</p>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan text-primary"></i> Check-in Form
                </h5>
            </div>
            <div class="gym-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MemberId" class="form-label">Select Member <span class="text-danger">*</span></label>
                        <select asp-for="MemberId" asp-items="@(ViewBag.Members)" class="form-select">
                            <option value="">-- Select Member --</option>
                        </select>
                        <span asp-validation-for="MemberId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CheckInDateTime" class="form-label">Check-in Date & Time <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-clock text-muted"></i></span>
                            <input asp-for="CheckInDateTime" type="datetime-local" class="form-control border-start-0" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <span asp-validation-for="CheckInDateTime" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="e.g. Locker key #12, Personal training session, Guest pass..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn-gym-primary">
                            <i class="bi bi-check-lg"></i> Confirm Check-In
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}