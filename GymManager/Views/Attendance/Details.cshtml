@model GymManager.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";
    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var initial = string.IsNullOrEmpty(Model.Member?.FullName) ? "M" : Model.Member.FullName.Substring(0, 1).ToUpper();
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Attendance
        </a>
        <h1>Attendance Entry</h1>
        <p>Detailed verification for this member visit record.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-gym-primary">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn-gym-outline text-danger">
            <i class="bi bi-trash3"></i> Delete
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan text-primary"></i> Check-in Log #@Model.Id
                </h5>
                <span class="gym-badge gym-badge-success"><span class="gym-status-pulse"></span> Recorded</span>
            </div>
            <div class="gym-card-body">
                <div class="row g-4">
                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Member Name</label>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center"
                                 style="width: 34px; height: 34px; font-size: 0.85rem;">
                                @initial
                            </div>
                            <span class="fw-bold fs-6 text-dark">@(Model.Member?.FullName ?? "Unknown Member")</span>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Member Phone</label>
                        <div class="fw-semibold fs-6 text-dark">
                            <i class="bi bi-telephone text-primary me-1"></i>@(Model.Member?.Phone ?? "-")
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Check-in Date</label>
                        <div class="fw-bold fs-6 text-dark">
                            <i class="bi bi-calendar3 text-muted me-1"></i>@Model.CheckInDateTime.ToString("dddd, dd MMMM yyyy", englishCulture)
                        </div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted small text-uppercase">Check-in Time</label>
                        <div class="fw-bold fs-6 text-primary">
                            <i class="bi bi-clock text-primary me-1"></i>@Model.CheckInDateTime.ToString("hh:mm:ss tt", englishCulture)
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small text-uppercase">Notes</label>
                        <div class="p-3 bg-light rounded-3 border text-secondary">
                            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes recorded for this visit." : Model.Notes)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>