@model GymManager.Models.Payment

@{
    ViewData["Title"] = "Edit Payment";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a asp-action="Index" class="btn-gym-outline btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Back to Payments
        </a>
        <h1>Edit Payment Record</h1>
        <p>Modify payment details or transaction notes.</p>
    </div>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="gym-card">
            <div class="gym-card-header">
                <h5 class="gym-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i> Payment #@Model.Id
                </h5>
            </div>
            <div class="gym-card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase">Member & Plan</label>
                        <div class="p-2 bg-light rounded-3 border fw-bold text-dark d-flex justify-content-between">
                            <span><i class="bi bi-person-fill text-primary me-2"></i>@(Model.Membership?.Member?.FullName ?? "Unknown Member")</span>
                            <span class="gym-badge gym-badge-primary">@(Model.Membership?.MembershipPlan?.Name ?? "Plan")</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Amount" class="form-label">Amount Paid ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar text-muted"></i></span>
                                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="PaymentDate" class="form-label">Payment Date & Time <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event text-muted"></i></span>
                                <input asp-for="PaymentDate" type="datetime-local" class="form-control border-start-0" />
                            </div>
                            <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Bank Transfer">Bank Transfer / Instapay</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn-gym-outline">Cancel</a>
                        <button type="submit" class="btn-gym-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}